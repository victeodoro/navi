// Navi: rofi launcher
configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Colloid-Orange-Gruvbox-Light";
  font: "JetBrainsMono Nerd Font 11";
  drun-display-format: "{name}";
  display-drun: " apps";
  display-run: " run";
  display-window: " windows";
}

// Full path on purpose: a bare "navi" matches the ~/navi repo folder
// when rofi starts from $HOME, and rofi then fails to load the theme.
@theme "~/.config/rofi/navi.rasi"
