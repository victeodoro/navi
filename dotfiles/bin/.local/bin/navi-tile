#!/usr/bin/env python3
"""navi-tile: Cinnamon-style directional tiling for xfwm4.

xfwm4 can tile, but each key does one fixed thing. Cinnamon combines them:
press Left, then Up, and the window goes to the top-left quarter. This
script reads where the active window is now and picks the next spot.

    navi-tile left|right|up|down

  state \\ key   left         right         up            down
  normal        left         right         top           bottom
  left          (stay)       restore       top-left      bottom-left
  right         restore      (stay)        top-right     bottom-right
  top           top-left     top-right     maximize      restore
  bottom        bottom-left  bottom-right  restore       (stay)
  top-left      (stay)       top-right     top           left
  top-right     top-left     (stay)        top           right
  bottom-left   (stay)       bottom-right  left          bottom
  bottom-right  bottom-left  (stay)        right         bottom
  maximized     left         right         (stay)        restore

Needs: wmctrl, xprop (x11-utils). Original sizes are remembered in
~/.cache/navi-tile so "restore" puts the window back where it was.
"""
import json, os, re, subprocess, sys

TOL = 12  # px of slack when deciding which spot a window is in
CACHE = os.path.expanduser("~/.cache/navi-tile")

NEXT = {
    "normal":       {"left": "left", "right": "right", "up": "top", "down": "bottom"},
    "left":         {"right": "restore", "up": "top-left", "down": "bottom-left"},
    "right":        {"left": "restore", "up": "top-right", "down": "bottom-right"},
    "top":          {"left": "top-left", "right": "top-right", "up": "maximized", "down": "restore"},
    "bottom":       {"left": "bottom-left", "right": "bottom-right", "up": "restore"},
    "top-left":     {"right": "top-right", "up": "top", "down": "left"},
    "top-right":    {"left": "top-left", "up": "top", "down": "right"},
    "bottom-left":  {"right": "bottom-right", "up": "left", "down": "bottom"},
    "bottom-right": {"left": "bottom-left", "up": "right", "down": "bottom"},
    "maximized":    {"left": "left", "right": "right", "down": "restore"},
}


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def ints(s):
    return [int(n) for n in re.findall(r"-?\d+", s.split("=", 1)[-1])]


def active_window():
    out = sh("xprop", "-root", "_NET_ACTIVE_WINDOW")
    m = re.search(r"0x[0-9a-f]+", out)
    return m.group(0) if m and int(m.group(0), 16) else None


def frame_rect(wid):
    """Outer rectangle (with title bar/borders) and the frame extents."""
    info = sh("xwininfo", "-id", wid)
    x = int(re.search(r"Absolute upper-left X:\s+(-?\d+)", info).group(1))
    y = int(re.search(r"Absolute upper-left Y:\s+(-?\d+)", info).group(1))
    w = int(re.search(r"Width:\s+(\d+)", info).group(1))
    h = int(re.search(r"Height:\s+(\d+)", info).group(1))
    ext = ints(sh("xprop", "-id", wid, "_NET_FRAME_EXTENTS")) or [0, 0, 0, 0]
    l, r, t, b = (ext + [0, 0, 0, 0])[:4]
    return (x - l, y - t, w + l + r, h + t + b), (l, r, t, b)


def workarea():
    x, y, w, h = ints(sh("xprop", "-root", "_NET_WORKAREA"))[:4]
    return x, y, w, h


def spots(wa):
    x, y, w, h = wa
    hw, hh = w // 2, h // 2
    return {
        "left": (x, y, hw, h),            "right": (x + hw, y, w - hw, h),
        "top": (x, y, w, hh),             "bottom": (x, y + hh, w, h - hh),
        "top-left": (x, y, hw, hh),       "top-right": (x + hw, y, w - hw, hh),
        "bottom-left": (x, y + hh, hw, h - hh),
        "bottom-right": (x + hw, y + hh, w - hw, h - hh),
    }


def current_state(wid, rect, wa):
    state = sh("xprop", "-id", wid, "_NET_WM_STATE")
    if "MAXIMIZED_VERT" in state and "MAXIMIZED_HORZ" in state:
        return "maximized"
    for name, s in spots(wa).items():
        if all(abs(a - b) <= TOL for a, b in zip(rect, s)):
            return name
    return "normal"


def load(wid):
    try:
        with open(os.path.join(CACHE, wid)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(wid, rect):
    os.makedirs(CACHE, exist_ok=True)
    with open(os.path.join(CACHE, wid), "w") as f:
        json.dump(rect, f)


def place(wid, rect, ext):
    """wmctrl takes the frame's top-left but the *client* size."""
    x, y, w, h = rect
    l, r, t, b = ext
    sh("wmctrl", "-i", "-r", wid, "-b", "remove,maximized_vert,maximized_horz")
    sh("wmctrl", "-i", "-r", wid, "-e", f"0,{x},{y},{w - l - r},{h - t - b}")


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("left", "right", "up", "down"):
        sys.exit(__doc__)
    key = sys.argv[1]
    wid = active_window()
    if not wid:
        return
    rect, ext = frame_rect(wid)
    wa = workarea()
    state = current_state(wid, rect, wa)
    target = NEXT[state].get(key)
    if not target:
        return
    if state == "normal":
        save(wid, rect)                       # remember for "restore"
    if target == "maximized":
        sh("wmctrl", "-i", "-r", wid, "-b", "add,maximized_vert,maximized_horz")
    elif target == "restore":
        old = load(wid)
        if old:
            place(wid, old, ext)
        else:
            sh("wmctrl", "-i", "-r", wid, "-b", "remove,maximized_vert,maximized_horz")
    else:
        place(wid, spots(wa)[target], ext)


if __name__ == "__main__":
    main()
